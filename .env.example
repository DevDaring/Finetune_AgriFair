# ============================================================
# AgriFair XLoRA-Bias — secrets template. Copy to .env and fill in.
# Canonical names are listed first; legacy aliases (right) are also accepted by
# GPU_Run/common/env_loader.py, so an existing .env works unchanged.
# NEVER commit .env.
# ============================================================

# --- HuggingFace (download script only; gated repos need this) ---
HUGGINGFACE_TOKEN=            # alias for HF_KEY

# --- Gemini (primary judge, 4 keys round-robin) ---
GEMINI_API_KEY_1=            # alias for GCP_Key1
GEMINI_API_KEY_2=            # alias for GCP_Key2
GEMINI_API_KEY_3=            # alias for GCP_Key3
GEMINI_API_KEY_4=            # alias for GCP_key4  (lowercase 'key' intentional)
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- DeepSeek (secondary judge + prompt-engineering, 2 keys) ---
DEEPSEEK_API_KEY_1=          # alias for DEEPSEEK_KEY1
DEEPSEEK_API_KEY_2=          # alias for DEEPSEEK_KEY2
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_JUDGE_MODEL_NAME=deepseek-chat

# --- OpenRouter (alternate route for DeepSeek tier, 2 keys) ---
OPENROUTER_API_KEY_1=        # alias for OPENROUTER_KEY1
OPENROUTER_API_KEY_2=        # alias for OPENROUTER_KEY2
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL_NAME=openai/gpt-4o-mini

# --- Mistral (tertiary judge, 2 keys) ---
MISTRAL_API_KEY1=            # alias for MISTRAL_KEY1
MISTRAL_API_KEY2=            # alias for MISTRAL_KEY2
MISTRAL_MODEL_NAME=mistral-small-latest

# --- Crash-safe autosync (optional) ---
Github_Classic_Token=        # alias for GITHUB_TOKEN
GPU_RUN_ARTIFACTS_BRANCH=gpu-run-artifacts

# --- Optional overrides ---
# SUBJECT_MODELS=small-instruct,broad-instruct
# SMOKE_MODEL_ID=sshleifer/tiny-gpt2
# PRIMARY_DATASET_REPO=Debk/AgriFair
# GENERAL_REPLAY_REPO=databricks/databricks-dolly-15k
# MULTILINGUAL_EMBED_MODEL=
