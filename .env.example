# ============================================================
# AgriFair GRAFT - secrets template. Copy to .env and fill in.
# Canonical names are listed first; the legacy aliases on the right are also accepted by
# GPU_Run/common/env_loader.py, so an existing .env works unchanged.
# NEVER commit .env.
# ============================================================

# --- HuggingFace ---
# Required. Debk/AgriFair is a PRIVATE dataset repository, and all four subject models are
# gated: Llama 3.2, Gemma 3 and Ministral each need their licence accepted on the Hub by the
# account that owns this token. Used only by the download scripts.
HUGGINGFACE_TOKEN=            # alias for HF_KEY

# --- The judge chain, in strict order, no retries ---
# DeepSeek key 1 -> DeepSeek key 2 -> Mistral key 1 -> Mistral key 2. Used only to read a
# letter out of an unparseable output, to score rationale factual correctness, and for the
# advice-drift cross-check. Never for an answer, and never shown a gold label.

# --- Gemini (not in the judge chain; kept for compatibility with older .env files) ---
GEMINI_API_KEY_1=            # alias for GCP_Key1
GEMINI_API_KEY_2=            # alias for GCP_Key2
GEMINI_API_KEY_3=            # alias for GCP_Key3
GEMINI_API_KEY_4=            # alias for GCP_key4  (lowercase 'key' intentional)
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- DeepSeek (judge routes 1 and 2, and the instruction-wrapper review) ---
DEEPSEEK_API_KEY_1=          # alias for DEEPSEEK_KEY1
DEEPSEEK_API_KEY_2=          # alias for DEEPSEEK_KEY2
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_JUDGE_MODEL_NAME=deepseek-chat

# --- OpenRouter (alternate route for the DeepSeek tier, 2 keys) ---
OPENROUTER_API_KEY_1=        # alias for OPENROUTER_KEY1
OPENROUTER_API_KEY_2=        # alias for OPENROUTER_KEY2
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL_NAME=openai/gpt-4o-mini

# --- Mistral (judge routes 3 and 4, and the secondary half of the agreement check) ---
MISTRAL_API_KEY1=            # alias for MISTRAL_KEY1
MISTRAL_API_KEY2=            # alias for MISTRAL_KEY2
MISTRAL_MODEL_NAME=mistral-small-latest

# --- Native provider keys (primary routes for two frontier-panel models) ---
# Claude Sonnet 5 goes to Anthropic directly, GPT-5.6 Luna to OpenAI directly, and both fall
# back to the two OpenRouter keys above. The Anthropic key here is workspace-scoped, so the
# workspace id is required alongside it.
ANTHROPIC_DIRECT_KEY=        # alias for Calude_2009_API_Key
ANTHROPIC_WORKSPACE_ID=      # alias for Claude_workspace_id
OPENAI_DIRECT_KEY=           # alias for Open_AI_2009_Key

# --- AWS Bedrock (Nova 2 Lite and Nemotron Nano 3 30B) ---
# Two independent accounts, round-robined per request. If one fails the other is tried, and
# if both fail the OpenRouter keys above take over. There are no retries anywhere: every
# failure falls straight through to the next route.
# Claude Sonnet 5 and GPT-5.6 Luna are deliberately NOT routed here: these are AWS India
# (AISPL) accounts, which cannot subscribe to third-party Marketplace models.
AWS_ACCESS_KEY=              # account 1
AWS_SECRET_KEY=
AWS_ACCESS_KEY2=             # account 2
AWS_SECRET_KEY2=
AWS_REGION=us-east-1

# --- Crash-safe autosync (optional) ---
Github_Classic_Token=        # alias for GITHUB_TOKEN
GPU_RUN_ARTIFACTS_BRANCH=gpu-run-artifacts

# ============================================================
# Optional overrides. Every one has a working default; these are the switches an
# operator actually reaches for.
# ============================================================
# Subject models. All four tiers are primary; SUBJECT_MODELS restricts the active set, which
# is the lever for fitting the study to a compute budget. Full sweep is roughly 110-170 H100-hours.
#   small-instruct      meta-llama/Llama-3.2-3B-Instruct        3.2B
#   broad-instruct      Qwen/Qwen3-4B-Instruct-2507             4.0B
#   general-instruct    google/gemma-3-12b-it                  12.2B
#   general-instruct-2  mistralai/Ministral-8B-Instruct-2410     8.0B
# SUBJECT_MODELS=small-instruct,broad-instruct
# SMOKE_MODEL_ID=hf-internal-testing/tiny-random-LlamaForCausalLM
# PRIMARY_DATASET_REPO=Debk/AgriFair
# GENERAL_REPLAY_REPO=databricks/databricks-dolly-15k
# CAPABILITY_PROBE_REPO=cais/mmlu               # the external "preserve the rest" probe
# CAPABILITY_PROBE_SIZE=500
# MULTILINGUAL_EMBED_MODEL=                     # set to use sentence embeddings for advice drift
#
# Study design
# STRUCTURE_NOVEL_KEY_FRACTION=0.20   # share of state-blind keys reserved for the novel test slice
# ATTRIBUTION_THRESHOLD=0.15          # layer selection threshold, fraction of the max attribution
# LORA_RANK_MIN=4
# LORA_RANK_MAX=64
# RANDOM_PLACEMENT_DRAWS=3            # independent random layer sets in the placement ablation
# LOAO_AXES=social_group,landholding,gender
# RUN_LEAVE_ONE_AXIS_OUT=1
# GRAFT_FULL_SWEEP=1                  # ablations, rank sweep and the QLoRA arm
# PRESERVATION_TOLERANCE=0.02
# INVASIVENESS_CEILING=1.0
# ADVICE_DRIFT_THRESHOLD=0.25
#
# Frozen frontier panel. Hosted models, behaviour only; they are never repair targets and
# never enter the main comparison table. Off by default because it spends money.
# RUN_FRONTIER_PANEL=1
# API_SUBJECT_MODELS=frontier-claude-sonnet-5,frontier-nemotron-nano-3-30b,frontier-nova-2-lite,frontier-gpt-5-6-luna
# FRONTIER_EVAL_SUBSET_SIZE=0        # 0 means the whole frozen test set
# FRONTIER_ADVICE_SUBSET_SIZE=0      # 0 means all 800 AgriAdvice pairs
# FRONTIER_ROTATION_SUBSET_SIZE=150
# FRONTIER_SWAP_SUBSET_SIZE=150
# FRONTIER_MAX_WORKERS=4
# API_REQUEST_TIMEOUT_SECONDS=120
#
# Reduced-budget profile. Declared in PREREGISTRATION.md; unset means the full schedule.
# Restricting these narrows secondary claims and must be reported as narrowed.
# MULTI_SEED_TIERS=small-instruct,general-instruct
# RANK_SWEEP_TIERS=small-instruct,general-instruct
# LOAO_TIERS=small-instruct,general-instruct
# Already the default because they cost no registered number; set to "all" to restore:
# ADVICE_TARGET_SCOPE=headline
# BEHAVIOURAL_SWEEP_SCOPE=first_seed
#
# Throughput and recovery
# EVAL_BATCH_SIZE=16
# TRAIN_MICRO_BATCH_SIZE=8
# GRADIENT_CHECKPOINTING=0
# FORCE_RETRAIN=0                     # 1 retrains arms whose final adapter already exists
# FORCE_EVAL=0                        # 1 re-runs evaluation instead of reusing predictions
# DISABLE_JUDGE=0                     # 1 makes every judge call a no-op (fully offline)
