results_submission1_phase2/predictions/*.tmp
results_submission1_phase2/predictions/*.partial

# R3 unblinding key: maps assessment_id -> system and left/right order. Never leaves this machine,
# and must never be in a rater pack. The rating sheets themselves carry no system identity.
results_submission1_phase2/advice/KEEP_FROM_RATERS_*.csv

